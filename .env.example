# ============ REQUIRED ============
# Neon (production): use the *pooler* connection string from neon.tech dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_PASSWORD="change-me"

# Outbound link tag appended when visitors click listings (like kingbid.lol)
NEXT_PUBLIC_UTM_SOURCE="kingbid"

# Local board fallback when geo headers are missing (local dev)
DEFAULT_COUNTRY_CODE="US"

# Public launch timestamp (ISO 8601). Resets "since launch" counter — use start of your launch day.
# Example (Aug 23, 2026 UTC): 2026-08-23T00:00:00.000Z — set on Vercel Production, then redeploy.
LAUNCHED_AT=""

# Fallen Fund — disabled until legal/payment review (Phase 4). Grants are visibility-only, never cash.
FALLEN_FUND_ENABLED="false"
FALLEN_FUND_PCT="5"

# Dodo Pro subscriptions ($19 Founder Pro / $29 Room Pro) — fixed-amount PWYW products
DODO_FOUNDER_PRO_PRODUCT_ID="pdt_0Nm2z9ZHI8uSMGj2KPzcA"
DODO_ROOM_PRO_PRODUCT_ID="pdt_0Nm2zSAGAeI2UbUtdTKxd"

# Protect cron routes (Vercel Cron sends Authorization: Bearer <secret>)
CRON_SECRET="generate-a-long-random-string"

# ============ PAYMENTS — Dodo (recommended) ============
# Create a Pay-What-You-Want one-time product in Dodo dashboard.
# Webhook: https://kingbid.lol/api/webhooks/dodo  (event: payment.succeeded)
# Docs: https://docs.dodopayments.com/developer-resources/dynamic-pricing-checkout
#
# test_mode: use Test API key + test webhook secret from Dodo dashboard (Test Mode toggle)
# live_mode: use LIVE API key + LIVE webhook secret — real charges, no test cards
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_PRODUCT_ID=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"   # test_mode | live_mode
# Optional: force checkout currency (leave unset for adaptive INR/USD/AUD by country)
# DODO_BILLING_CURRENCY="USD"

# ============ PAYMENTS — Polar (alternative) ============
POLAR_ACCESS_TOKEN=""
POLAR_PRODUCT_ID=""
POLAR_WEBHOOK_SECRET=""

# Leave ALL payment keys empty for local mock checkout at /checkout/mock

# ============ EMAIL (Resend) ============
# Transactional: bid confirmation, outbid alerts (one-click re-bid link)
# Weekly digest: scheduled via /api/cron/digest (Mondays 9am UTC on Vercel)
RESEND_API_KEY=""
EMAIL_FROM="Kingbid <alerts@yoursite.com>"

# Contact email shown on /rules (payment disputes, support)
CONTACT_EMAIL="heyquixyz@gmail.com"

# About page founder block (optional)
NEXT_PUBLIC_FOUNDER_NAME="Mintu"
NEXT_PUBLIC_FOUNDER_HANDLE="Mintu_aa"
NEXT_PUBLIC_FOUNDER_X_URL="https://x.com/Mintu_aa"

# ============ TWITTER BOT (optional) ============
# Auto-posts when #1 changes. Create app at developer.twitter.com with Read+Write.
TWITTER_ENABLED="false"
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
