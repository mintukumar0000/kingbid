// Pay-to-rank leaderboard schema.
// Guardrail: listings only go live after owner submit or invite claim (status = active).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String   @default("")
  isMeta      Boolean  @default(false) @map("is_meta")
  createdAt   DateTime @default(now()) @map("created_at")
  boards      Board[]
  invites     Invite[]
  room        Room?

  @@map("categories")
}

model Board {
  id           String         @id @default(uuid())
  categoryId   String?        @map("category_id")
  category     Category?      @relation(fields: [categoryId], references: [id])
  region       String?
  createdAt    DateTime       @default(now()) @map("created_at")
  listings     Listing[]
  reignHistory ReignHistory[]
  dethronements Dethronement[]
  platformEvents PlatformEvent[]
  callItPredictions CallItPrediction[]

  @@unique([categoryId, region])
  @@map("boards")
}

model Listing {
  id             String    @id @default(uuid())
  boardId        String?   @map("board_id")
  board          Board?    @relation(fields: [boardId], references: [id])
  url            String    @unique
  slug           String    @unique
  displayUrl     String
  kind           String    @default("website")
  handle         String?
  title          String
  description    String    @default("")
  faviconUrl     String?   @map("favicon_url")
  ownerContact   String?   @map("owner_contact")
  status         String    @default("active") // pending_invite | active | removed
  claimedAt      DateTime? @map("claimed_at")
  currentBid     Int       @default(0)
  localBid       Int       @default(0)
  currentRank    Int?      @map("current_rank")
  countryCode    String?
  localLastBidAt DateTime?
  ownerEmail     String?
  creditBalance  Int       @default(0)
  clickCount     Int       @default(0)
  lastBidAt      DateTime  @default(now())
  takeoverUntil  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bids           Bid[]
  clicks         Click[]
  referrals      Bid[]              @relation("ReferralListing")
  reignHistory   ReignHistory[]
  matchupsAsA    Matchup[]          @relation("MatchupA")
  matchupsAsB    Matchup[]          @relation("MatchupB")
  badgeEmbeds    BadgeEmbed[]
  alertSubs      AlertSubscription[]
  revenueBand    String?            @map("revenue_band")
  verifications  Verification[]
  underdogScores UnderdogScore[]
  dethronements  Dethronement[]     @relation("DethronedListing")
  dethronedOthers Dethronement[]    @relation("DethronerListing")
  discoveryLists DiscoveryList[]
  callItTargets  CallItPrediction[]
  rivalsAsSelf   Rival[]            @relation("RivalSelf")
  rivalsAsTarget Rival[]            @relation("RivalTarget")
  notificationPrefs NotificationPreference[]
  fallenFundGrants FallenFundGrant[]
  migrationClaim MigrationClaim?
  nominationsReceived DethronementNomination[] @relation("Nominee")
  roomPins       RoomPin[]
  nominationsMade     DethronementNomination[] @relation("Nominator")

  @@index([currentBid(sort: Desc), lastBidAt])
  @@index([countryCode, localBid(sort: Desc), localLastBidAt])
  @@index([boardId, currentBid(sort: Desc)])
  @@index([status])
  @@map("listings")
}

model Bid {
  id                String    @id @default(uuid())
  listingId         String
  amount            Int
  creditApplied     Int       @default(0)
  bidIncrease       Int       @default(0)
  totalAfter        Int       @default(0)
  paymentId         String    @unique
  status            String    @default("pending")
  isTakeover        Boolean   @default(false)
  takeoverEnd       DateTime?
  email             String?
  scope             String    @default("global")
  countryCode       String?
  referralListingId String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  listing           Listing   @relation(fields: [listingId], references: [id])
  referralListing   Listing?  @relation("ReferralListing", fields: [referralListingId], references: [id])

  @@index([listingId, createdAt(sort: Desc)])
  @@index([status, completedAt(sort: Desc)])
  @@map("bids")
}

model Click {
  id        String   @id @default(cuid())
  listingId String
  ipHash    String
  referrer  String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId, createdAt])
  @@index([createdAt])
  @@map("clicks")
}

model ReignHistory {
  id        String    @id @default(uuid())
  listingId String    @map("listing_id")
  listing   Listing   @relation(fields: [listingId], references: [id])
  boardId   String    @map("board_id")
  board     Board     @relation(fields: [boardId], references: [id])
  rank      Int       @default(1)
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  isComeback Boolean  @default(false) @map("is_comeback")

  @@index([boardId, startedAt(sort: Desc)])
  @@map("reign_history")
}

model Matchup {
  id              String        @id @default(uuid())
  listingAId      String        @map("listing_a_id")
  listingBId      String        @map("listing_b_id")
  listingA        Listing       @relation("MatchupA", fields: [listingAId], references: [id])
  listingB        Listing       @relation("MatchupB", fields: [listingBId], references: [id])
  status          String        @default("pending")
  ownerAConfirmed Boolean       @default(false) @map("owner_a_confirmed")
  ownerBConfirmed Boolean       @default(false) @map("owner_b_confirmed")
  createdAt       DateTime      @default(now()) @map("created_at")
  votes           MatchupVote[]

  @@map("matchups")
}

model MatchupVote {
  id                String   @id @default(uuid())
  matchupId         String   @map("matchup_id")
  matchup           Matchup  @relation(fields: [matchupId], references: [id])
  voterSessionId    String   @map("voter_session_id")
  votedForListingId String   @map("voted_for_listing_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([matchupId, voterSessionId])
  @@map("matchup_votes")
}

model Invite {
  id             String    @id @default(uuid())
  categoryId     String?   @map("category_id")
  category       Category? @relation(fields: [categoryId], references: [id])
  invitedContact String    @map("invited_contact")
  claimToken     String    @unique @map("claim_token")
  status         String    @default("sent")
  reusable       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([categoryId, reusable])
  @@map("invites")
}

model BadgeEmbed {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id])
  embedToken String   @unique @map("embed_token")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("badge_embeds")
}

model AlertSubscription {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  listing       Listing  @relation(fields: [listingId], references: [id])
  contactMethod String   @map("contact_method")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("alert_subscriptions")
}

model Analytics {
  id        String   @id @default(cuid())
  event     String
  listingId String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@map("analytics")
}

model Visitor {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
  @@map("visitors")
}

model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("meta")
}

// ─── v2 Production Spec ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  handle    String?  @unique
  name      String?
  sessionId String?  @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  roomKeepers       RoomKeeper[]
  curatedRooms      Room[]              @relation("RoomCurator")
  kingbidScores     KingbidScore[]
  discoveryLists    DiscoveryList[]
  callItPredictions CallItPrediction[]
  rivals            Rival[]
  subscriptions     Subscription[]
  roomRequests      Room[]              @relation("RoomRequester")
  roomFollows       RoomFollow[]
  following         FounderFollow[]     @relation("Following")
  followers         FounderFollow[]     @relation("Followers")
  roomPins          RoomPin[]
  weeklyEvents      RoomWeeklyEvent[]
  categoryProposals CategoryProposal[]

  @@map("users")
}

model Room {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String   @default("")
  icon          String?
  parentRoomId  String?  @map("parent_room_id")
  parentRoom    Room?    @relation("RoomNesting", fields: [parentRoomId], references: [id])
  childRooms    Room[]   @relation("RoomNesting")
  categoryId    String?  @unique @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  roomType      String   @default("category") @map("room_type")
  curatorUserId String?  @map("curator_user_id")
  curator       User?    @relation("RoomCurator", fields: [curatorUserId], references: [id])
  requesterId   String?  @map("requester_id")
  requester     User?    @relation("RoomRequester", fields: [requesterId], references: [id])
  status        String   @default("active")
  sponsored     Boolean  @default(false)
  sponsorLabel  String?  @map("sponsor_label")
  geoRelevanceNote String? @map("geo_relevance_note")
  createdAt     DateTime @default(now()) @map("created_at")

  keepers        RoomKeeper[]
  platformEvents PlatformEvent[]
  follows        RoomFollow[]
  pins           RoomPin[]
  weeklyEvents   RoomWeeklyEvent[]

  @@index([parentRoomId])
  @@index([status])
  @@map("rooms")
}

model RoomKeeper {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  roomId      String   @map("room_id")
  room        Room     @relation(fields: [roomId], references: [id])
  level       String   @default("observer")
  leveledUpAt DateTime @default(now()) @map("leveled_up_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, roomId])
  @@map("room_keepers")
}

model RoomFollow {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  roomId    String   @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roomId])
  @@index([roomId])
  @@map("room_follows")
}

model FounderFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String   @map("following_id")
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("founder_follows")
}

model RoomPin {
  id             String   @id @default(uuid())
  roomId         String   @map("room_id")
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  listingId      String   @map("listing_id")
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pinnedByUserId String   @map("pinned_by_user_id")
  pinnedBy       User     @relation(fields: [pinnedByUserId], references: [id])
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([roomId, listingId])
  @@index([roomId, sortOrder])
  @@map("room_pins")
}

model RoomWeeklyEvent {
  id              String   @id @default(uuid())
  roomId          String   @map("room_id")
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  createdByUserId String   @map("created_by_user_id")
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  weekStart       DateTime @map("week_start")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([roomId, weekStart(sort: Desc)])
  @@map("room_weekly_events")
}

model CategoryProposal {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  slug        String
  name        String
  description String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("category_proposals")
}

model Dethronement {
  id                  String   @id @default(uuid())
  listingId           String   @map("listing_id")
  listing             Listing  @relation("DethronedListing", fields: [listingId], references: [id])
  boardId             String   @map("board_id")
  board               Board    @relation(fields: [boardId], references: [id])
  dethronedByListingId String  @map("dethroned_by_listing_id")
  dethronedBy         Listing  @relation("DethronerListing", fields: [dethronedByListingId], references: [id])
  occurredAt          DateTime @default(now()) @map("occurred_at")
  nominations         DethronementNomination[]

  @@index([boardId, occurredAt(sort: Desc)])
  @@map("dethronements")
}

model DethronementNomination {
  id             String       @id @default(uuid())
  dethronementId String       @map("dethronement_id")
  dethronement   Dethronement @relation(fields: [dethronementId], references: [id])
  nominatorListingId String   @map("nominator_listing_id")
  nominator      Listing      @relation("Nominator", fields: [nominatorListingId], references: [id])
  nomineeListingId   String @map("nominee_listing_id")
  nominee        Listing      @relation("Nominee", fields: [nomineeListingId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([dethronementId, nominatorListingId])
  @@map("dethronement_nominations")
}

model PlatformEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  boardId   String?  @map("board_id")
  board     Board?   @relation(fields: [boardId], references: [id])
  roomId    String?  @map("room_id")
  room      Room?    @relation(fields: [roomId], references: [id])
  listingId String?  @map("listing_id")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([boardId, createdAt(sort: Desc)])
  @@index([roomId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("platform_events")
}

model KingbidScore {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  score      Int      @default(0)
  components String   @default("{}")
  computedAt DateTime @default(now()) @map("computed_at")

  @@index([userId, computedAt(sort: Desc)])
  @@map("kingbid_scores")
}

model Verification {
  id               String   @id @default(uuid())
  listingId        String   @map("listing_id")
  listing          Listing  @relation(fields: [listingId], references: [id])
  verificationType String   @map("verification_type")
  provider         String?
  verifiedAt       DateTime? @map("verified_at")
  revenueBand      String?  @map("revenue_band")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([listingId])
  @@map("verifications")
}

model UnderdogScore {
  id             String   @id @default(uuid())
  listingId      String   @map("listing_id")
  listing        Listing  @relation(fields: [listingId], references: [id])
  boardId        String?  @map("board_id")
  bidAmountCents Int      @map("bid_amount_cents")
  revenueBand    String   @map("revenue_band")
  sacrificeScore Float    @map("sacrifice_score")
  computedAt     DateTime @default(now()) @map("computed_at")

  @@index([boardId, sacrificeScore(sort: Desc)])
  @@index([listingId, computedAt(sort: Desc)])
  @@map("underdog_scores")
}

model DiscoveryList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id])
  calledAt  DateTime @default(now()) @map("called_at")

  @@unique([userId, listingId])
  @@map("discovery_lists")
}

model CallItPrediction {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id])
  boardId             String   @map("board_id")
  board               Board    @relation(fields: [boardId], references: [id])
  predictedListingId  String   @map("predicted_listing_id")
  predictedListing    Listing  @relation(fields: [predictedListingId], references: [id])
  resolvesAt          DateTime @map("resolves_at")
  resolved            Boolean  @default(false)
  correct             Boolean?

  @@index([boardId, resolvesAt])
  @@map("call_it_predictions")
}

model Rival {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  listingId       String   @map("listing_id")
  listing         Listing  @relation("RivalSelf", fields: [listingId], references: [id])
  rivalListingId  String   @map("rival_listing_id")
  rivalListing    Listing  @relation("RivalTarget", fields: [rivalListingId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, listingId, rivalListingId])
  @@map("rivals")
}

model NotificationPreference {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  listing       Listing  @relation(fields: [listingId], references: [id])
  notifyOn      String   @map("notify_on")
  contactMethod String   @map("contact_method")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([listingId, notifyOn, contactMethod])
  @@map("notification_preferences")
}

model FallenFundPool {
  id              String   @id @default(uuid())
  weekStart       DateTime @map("week_start")
  totalPoolCents  Int      @default(0) @map("total_pool_cents")
  status          String   @default("accruing")
  createdAt       DateTime @default(now()) @map("created_at")
  grants          FallenFundGrant[]

  @@unique([weekStart])
  @@map("fallen_fund_pools")
}

model FallenFundGrant {
  id                 String         @id @default(uuid())
  poolId             String         @map("pool_id")
  pool               FallenFundPool @relation(fields: [poolId], references: [id])
  recipientListingId String         @map("recipient_listing_id")
  recipient          Listing        @relation(fields: [recipientListingId], references: [id])
  grantType          String         @map("grant_type")
  selectionRuleUsed  String         @map("selection_rule_used")
  awardedAt          DateTime       @default(now()) @map("awarded_at")

  @@map("fallen_fund_grants")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id])
  tier                 String
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  dodoPaymentId        String?  @unique @map("dodo_payment_id")
  status               String   @default("pending")
  renewsAt             DateTime? @map("renews_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("subscriptions")
}

model MigrationClaim {
  id                    String   @id @default(uuid())
  listingId             String   @unique @map("listing_id")
  listing               Listing  @relation(fields: [listingId], references: [id])
  claimedPreviousPlatform String @map("claimed_previous_platform")
  evidenceUrl           String?  @map("evidence_url")
  badge                 String
  claimedAt             DateTime @default(now()) @map("claimed_at")

  @@map("migration_claims")
}

model NepalCampaignPayment {
  id               String   @id @default(uuid())
  publicId         String   @unique @map("public_id")
  paymentId        String   @unique @map("payment_id")
  bidId            String   @unique @map("bid_id")
  amount           Int
  bidderLabel      String   @map("bidder_label")
  paymentStatus    String   @default("PAID") @map("payment_status")
  settlementStatus String   @default("PENDING_SETTLEMENT") @map("settlement_status")
  donationStatus   String   @default("PENDING") @map("donation_status")
  settlementId     String?  @map("settlement_id")
  settlement       NepalCampaignSettlement? @relation(fields: [settlementId], references: [id])
  donationId       String?  @map("donation_id")
  donation         NepalCampaignDonation? @relation(fields: [donationId], references: [id])
  paidAt           DateTime @map("paid_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([paidAt(sort: Desc)])
  @@index([settlementStatus])
  @@index([donationStatus])
  @@map("nepal_campaign_payments")
}

model NepalCampaignSettlement {
  id               String   @id @default(uuid())
  settlementNumber Int      @unique @map("settlement_number")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  grossAmount      Int      @map("gross_amount")
  adjustments      Int      @default(0)
  netAmount        Int      @map("net_amount")
  settlementDate   DateTime @map("settlement_date")
  status           String   @default("RECEIVED")
  evidenceUrl      String?  @map("evidence_url")
  createdAt        DateTime @default(now()) @map("created_at")
  payments         NepalCampaignPayment[]

  @@map("nepal_campaign_settlements")
}

model NepalCampaignDonation {
  id             String   @id @default(uuid())
  donationNumber Int      @unique @map("donation_number")
  amount         Int
  recipientName  String   @map("recipient_name")
  donatedAt      DateTime @map("donated_at")
  status         String   @default("CONFIRMED")
  receiptUrl     String?  @map("receipt_url")
  createdAt      DateTime @default(now()) @map("created_at")
  payments       NepalCampaignPayment[]

  @@map("nepal_campaign_donations")
}

model NepalVerificationRequest {
  id              String   @id @default(uuid())
  email           String
  name            String   @default("")
  message         String   @default("")
  paymentPublicId String?  @map("payment_public_id")
  listingUrl      String?  @map("listing_url")
  status          String   @default("pending") // pending | replied
  adminNotes      String   @default("") @map("admin_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  repliedAt       DateTime? @map("replied_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("nepal_verification_requests")
}
